    ["Arrow scale (x main)"] = "箭头缩放 (主 x)",
}

local MOD_VALUES = { none = "无", alt = "Alt", ctrl = "Ctrl", shift = "Shift" }

local function translate(value)
    if type(value) ~= "string" then
        return nil
    end
    return MAP[value]
end

local function walk(node, depth)
    if depth > 6 or type(node) ~= "table" then
        return
    end
    for key, value in pairs(node) do
        if type(value) == "table" then
            local label = value[2]
            if #value == 2 and type(value[1]) == "string" and type(label) == "string" and MOD_VALUES[value[1]] then
                value[2] = MOD_VALUES[value[1]]
            else
                walk(value, depth + 1)
            end
            local hit = translate(value.label)
            if hit then
                value.label = hit
            end
            local hit_text = translate(value.text)
            if hit_text then
                value.text = hit_text
            end
        elseif key == "label" or key == 4 then
            local hit = translate(value)
            if hit then
                node[key] = hit
            end
        end
    end
end

local function wrap(name)
    local original = wd_gui[name]
    if type(original) ~= "function" then
        printf("[MT-CN] wd i18n: wd_gui.%s missing, skipped", name)
        return
    end
    wd_gui[name] = function(...)
        for _, arg in ipairs({ ... }) do
            if type(arg) == "table" then
                walk(arg, 1)
            end
        end
        return original(...)
    end
end

-- Registration entry points wd_boot calls during on_game_start, after this file has loaded.
wrap("register_tab")
wrap("register_device")
wrap("register_global_toggle")
wrap("new_catalog_enum")

if wd_mcm and type(wd_mcm.on_mcm_load) == "function" then
    local original_mcm = wd_mcm.on_mcm_load
    wd_mcm.on_mcm_load = function(...)
        local result = original_mcm(...)
        walk(result, 1)
        return result
    end
end

local map_size = 0
for _ in pairs(MAP) do
    map_size = map_size + 1
end
-- Engine printf substitutes %s only, hence tostring on the count.
printf("[MT-CN] wd i18n active: %s label keys; wrapped register_tab/register_device/register_global_toggle/new_catalog_enum%s",
    tostring(map_size), (wd_mcm and type(wd_mcm.on_mcm_load) == "function") and " + wd_mcm" or "")

+// Called from render_sun_cascade right after this cascade's accumulation, i.e. while the
+// single shadow map still holds this cascade's depth (the next cascade overwrites it).
+// The numeric probe then samples the map with this cascade's own matrix, which is the only
+// way to tell a correct near-cascade shadow from a map content or transform error.
+void CRender::DumpShadowMapCascade(u32 cascade_ind)
+{
+	// The lens pass renders with its own projection and target; the dump must describe the
+	// view the player sees, so only the main target is captured. The flag then stays set
+	// until the main view's cascade loop consumes it.
+	if (TargetMain && Target != TargetMain)
+		return;
+	CRenderTarget* T = Target;
+	if (!T || cascade_ind >= m_sun_cascades.size())
+		return;
+
+	string_path name, full;
+	// Sequence first so a second dump from another yaw does not overwrite the first set.
+	xr_sprintf(name, "dbg_smap_d%u_c%u.bmp", g_svpDumpSmapSeq, cascade_ind);
+	FS.update_path(full, "$logs$", name);
+	svp_dump_rt(full, T->rt_smap_depth);
+
+	const Fmatrix& X = m_sun_cascades[cascade_ind].xform;
+	Msg("* [DBG] smap c=%u seq=%u cam pos=(%.2f %.2f %.2f) dir=(%.3f %.3f %.3f) sun_dir=(%.4f %.4f %.4f)",
+		cascade_ind, g_svpDumpSmapSeq,
+		Device.vCameraPosition.x, Device.vCameraPosition.y, Device.vCameraPosition.z,
+		Device.vCameraDirection.x, Device.vCameraDirection.y, Device.vCameraDirection.z,
+		g_pGamePersistent->Environment().CurrentEnv->sun_dir.x,
+		g_pGamePersistent->Environment().CurrentEnv->sun_dir.y,
+		g_pGamePersistent->Environment().CurrentEnv->sun_dir.z);
+	Msg("* [DBG] smap c=%u r0=(%.6f %.6f %.6f %.6f) r1=(%.6f %.6f %.6f %.6f) r2=(%.6f %.6f %.6f %.6f) r3=(%.6f %.6f %.6f %.6f)",
+		cascade_ind, X._11, X._12, X._13, X._14, X._21, X._22, X._23, X._24,
+		X._31, X._32, X._33, X._34, X._41, X._42, X._43, X._44);
+
+	svp_probe_shadow_numeric(T, m_sun_cascades, g_svpDumpSmapSeq, int(cascade_ind));
+
+	xr_vector<dxRender_Visual*> tall;
+	CollectNearbyVisuals(40.f, tall);
+	svp_measure_shadow_offsets(T, m_sun_cascades, cascade_ind, g_svpDumpSmapSeq, tall);
+
+	{
+		extern int ps_r__sun_shadow_casters;
+		extern dxRender_Visual* g_sun_caster_only;
+		if (ps_r__sun_shadow_casters == 4 && g_sun_caster_only)
+			svp_single_caster_blob(T, m_sun_cascades, cascade_ind, g_sun_caster_only, g_svpDumpSmapSeq);
+	}
+
+	if (cascade_ind + 1 == m_sun_cascades.size())
+		g_svpDumpSmap = false;
+}

+// Numeric CSM ground truth: read the G-buffer position, the sun accumulator and the
+// shadow map back, reconstruct the world point of a screen pixel and the world point
+// stored in the shadow map under it, then log both. This answers "is the dark pixel a
+// CSM shadow, and where is the caster the map placed it from" without any image reading.
+static float svp_h2f(u16 h)
+{
+	const u32 sign = (h >> 15) & 1u, exp = (h >> 10) & 0x1Fu, man = h & 0x3FFu;
+	float v;
+	if (exp == 0) v = man ? ldexpf(float(man), -24) : 0.f;
+	else if (exp == 31) v = man ? 1.f : 1.f;
+	else v = ldexpf(float(man) + 1024.f, int(exp) - 25);
+	return sign ? -v : v;
+}
+
+static bool svp_read_rt_full(ref_rt& rt, xr_vector<u8>& data, u32& w, u32& h, u32& pitch, DXGI_FORMAT& fmt)
+{
+	if (!rt || !rt->pSurface) return false;
+	ID3D11Texture2D* tex = nullptr;
+	if (FAILED(rt->pSurface->QueryInterface(__uuidof(ID3D11Texture2D), (void**)&tex)) || !tex) return false;
+	D3D11_TEXTURE2D_DESC d = {};
+	tex->GetDesc(&d);
+	D3D11_TEXTURE2D_DESC s = d;
+	s.Usage = D3D11_USAGE_STAGING;
+	s.BindFlags = 0;
+	s.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+	s.MiscFlags = 0;
+	s.ArraySize = 1;
+	s.MipLevels = 1;
+	s.SampleDesc.Count = 1;
+	s.SampleDesc.Quality = 0;
+	ID3D11Texture2D* stg = nullptr;
+	if (FAILED(HW.pDevice->CreateTexture2D(&s, nullptr, &stg)) || !stg) { _RELEASE(tex); return false; }
+	HW.pContext->CopyResource(stg, tex);
+	_RELEASE(tex);
+	D3D11_MAPPED_SUBRESOURCE m = {};
+	if (FAILED(HW.pContext->Map(stg, 0, D3D11_MAP_READ, 0, &m)))
+	{
+		stg->Release();
+		return false;
+	}
+	w = d.Width; h = d.Height; pitch = m.RowPitch; fmt = d.Format;
+	data.resize(size_t(pitch) * h);
+	memcpy(data.data(), m.pData, data.size());
+	HW.pContext->Unmap(stg, 0);
+	stg->Release();
+	return true;
+}
+
+static void svp_probe_shadow_numeric(CRenderTarget* T, const xr_vector<sun::cascade>& cascades, u32 dumpSeq, int onlyCascade)
+{
+	if (!T)
+		return;
+	xr_vector<u8> pos, acc, smap;
+	u32 pw = 0, ph = 0, pp = 0, aw = 0, ah = 0, ap = 0, sw = 0, sh = 0, sp = 0;
+	DXGI_FORMAT pf = DXGI_FORMAT_UNKNOWN, af = DXGI_FORMAT_UNKNOWN, sf = DXGI_FORMAT_UNKNOWN;
+	if (!svp_read_rt_full(T->rt_Position, pos, pw, ph, pp, pf) ||
+		!svp_read_rt_full(T->rt_Accumulator, acc, aw, ah, ap, af) ||
+		!svp_read_rt_full(T->rt_smap_depth, smap, sw, sh, sp, sf))
+	{
+		Msg("* [DBG] probe: readback failed (pos=%ux%u fmt=%u accum=%ux%u fmt=%u smap=%ux%u fmt=%u)",
+			pw, ph, pf, aw, ah, af, sw, sh, sf);
+		return;
+	}
+	Msg("* [DBG] probe: d=%u mode=%d pos=%ux%u fmt=%u accum=%ux%u fmt=%u smap=%ux%u fmt=%u",
+		dumpSeq, onlyCascade, pw, ph, pf, aw, ah, af, sw, sh, sf);
+	if (pf != DXGI_FORMAT_R16G16B16A16_FLOAT || af != DXGI_FORMAT_R16G16B16A16_FLOAT)
+		return;
+
+	const float VertTan = -1.f / Device.mProject._22;
+	const float HorzTan = 1.f / Device.mProject._11;   // positive, as in R2/R3 and in the fixed
+	                                                   // pos_decompression_params binder (r4.cpp)
+	const float sx = 2.f * HorzTan / float(pw);
+	const float sy = 2.f * VertTan / float(ph);
+	// Screen projection = the exact algebraic inverse of the reconstruction below, driven by
+	// Device.mView only. Before r4.cpp's HorzTan sign was corrected, projecting through
+	// mFullTransform disagreed with the reconstruction by a mirror in u ("the caster of a
+	// sample 0.78 m from its receiver landed 330 px away") - that was the engine defect, not
+	// the instrument, and adopting the mirrored relation hid it. rcv=(u,v) below is still the
+	// round-trip proof, but a mirror is round-trip invisible, so it only proves self-consistency.
+	auto svp_screen_uv = [&](const Fvector& P, float& outU, float& outV) -> bool {
+		Fvector Pv2;
+		Device.mView.transform_tiny(Pv2, P);
+		if (Pv2.z < 0.05f || _abs(HorzTan) < 1e-6f || _abs(VertTan) < 1e-6f)
+			return false;
+		outU = 0.5f * (1.f + Pv2.x / (Pv2.z * HorzTan));
+		outV = 0.5f * (1.f + Pv2.y / (Pv2.z * VertTan));
+		return true;
+	};
+	Msg("* [DBG] probe cam p11=%.4f p22=%.4f ht=%.4f vt=%.4f view=(%.4f %.4f %.4f) target=%s",
+		Device.mProject._11, Device.mProject._22, HorzTan, VertTan,
+		Device.mView._11, Device.mView._22, Device.mView._33,
+		(T == RImplementation.Target) ? "active" : "other");
+
+	// Does the caster the shadow map reports actually exist in the visible image?
+	// Project the reconstructed occluder through the camera and compare it with the
+	// G-buffer surface at that pixel: a real trunk sits within its own thickness of the
+	// projected point; a shadow-only / wrongly transformed caster projects onto ground
+	// many metres behind. This is the numeric version of "the shadow has no object".
+	u32 nCasterNear = 0, nCasterFar = 0, nCasterOff = 0, nShadowed = 0;
+
+	Fvector to_sun;
+	to_sun.set(g_pGamePersistent->Environment().CurrentEnv->sun_dir).invert().normalize();
+
+	Fmatrix inv[4];
+	bool invok[4] = { false, false, false, false };
+	for (u32 c = 0; c < cascades.size() && c < 4; ++c)
+	{
+		inv[c].invert(cascades[c].xform);
+		invok[c] = true;
+	}
+
+	for (u32 y = 0; y < ph; y += 40)
+	{
+		for (u32 x = 0; x < pw; x += 40)
+		{
+			const u16* hp = (const u16*)(pos.data() + size_t(y) * pp + size_t(x) * 8);
+			const float pz = svp_h2f(hp[2]);
+			if (pz < 0.2f)
+				continue;
+
+			Fvector Pv;
+			Pv.set(pz * ((x + 0.5f) * sx - HorzTan), pz * ((y + 0.5f) * sy - VertTan), pz);
+			Fvector Pw;
+			Device.mInvView.transform(Pw, Pv);
+
+			const u16* ap0 = (const u16*)(acc.data() + size_t(y) * ap + size_t(x) * 8);
+			const float lum = (svp_h2f(ap0[0]) + svp_h2f(ap0[1]) + svp_h2f(ap0[2])) / 3.f;
+
+			const u32 c0 = (onlyCascade >= 0) ? u32(onlyCascade) : 0u;
+			const u32 c1 = (onlyCascade >= 0) ? u32(onlyCascade + 1) : u32(cascades.size());
+			for (u32 c = c0; c < c1 && c < 4; ++c)
+			{
+				const Fmatrix& X = cascades[c].xform;
+				const float cx = Pw.x * X._11 + Pw.y * X._21 + Pw.z * X._31 + X._41;
+				const float cy = Pw.x * X._12 + Pw.y * X._22 + Pw.z * X._32 + X._42;
+				const float cz = Pw.x * X._13 + Pw.y * X._23 + Pw.z * X._33 + X._43;
+				const float cw = Pw.x * X._14 + Pw.y * X._24 + Pw.z * X._34 + X._44;
+				if (cw <= 1e-4f)
+					continue;
+				const float u = 0.5f + 0.5f * cx / cw;
+				const float v = 0.5f - 0.5f * cy / cw;
+				const float dp = cz / cw;
+				if (u < 0.f || u > 1.f || v < 0.f || v > 1.f)
+					continue;
+
+				const int ix = clampr(int(u * sw), 0, int(sw) - 1);
+				const int iy = clampr(int(v * sh), 0, int(sh) - 1);
+				const u32 raw = *(const u32*)(smap.data() + size_t(iy) * sp + size_t(ix) * 4);
+				float dm = -1.f;
+				if (sf == DXGI_FORMAT_D32_FLOAT || sf == DXGI_FORMAT_R32_FLOAT)
+					dm = *(const float*)&raw;
+				else if (sf == DXGI_FORMAT_R24G8_TYPELESS || sf == DXGI_FORMAT_D24_UNORM_S8_UINT)
+					dm = float(raw & 0x00FFFFFFu) / 16777215.0f;
+				// dp outside [0,1] means the receiver is outside this cascade's ortho
+				// volume; the lighting pass is clipped to that volume, so such a sample is
+				// not rendered and must not count as a shadow of this cascade.
+				const bool shadowed = (dp >= 0.f && dp <= 1.f) && dm >= 0.f && dm < dp - 0.001f;
+
+				Fvector occ;
+				occ.set(0, 0, 0);
+				if (invok[c])
+				{
+					Fvector clip;
+					clip.set(2.f * u - 1.f, 1.f - 2.f * v, dm);
+					inv[c].transform(occ, clip);
+				}
+				const float offx = occ.x - Pw.x;
+				const float offz = occ.z - Pw.z;
+				const float side = offx * to_sun.x + offz * to_sun.z;
+
+				float ru = -1.f, rv = -1.f;
+				svp_screen_uv(Pw, ru, rv);
+
+				float cu = -1.f, cv = -1.f, dOcc = -1.f;
+				if (shadowed)
+				{
+					++nShadowed;
+					svp_screen_uv(occ, cu, cv);
+					if (cu >= 0.f && cu <= 1.f && cv >= 0.f && cv <= 1.f)
+					{
+						const int vx = clampr(int(cu * pw), 0, int(pw) - 1);
+						const int vy = clampr(int(cv * ph), 0, int(ph) - 1);
+						const u16* vp = (const u16*)(pos.data() + size_t(vy) * pp + size_t(vx) * 8);
+						const float vz = svp_h2f(vp[2]);
+						if (vz >= 0.2f)
+						{
+							Fvector Pvv;
+							Pvv.set(vz * ((vx + 0.5f) * sx - HorzTan), vz * ((vy + 0.5f) * sy - VertTan), vz);
+							Fvector Pvis;
+							Device.mInvView.transform(Pvis, Pvv);
+							dOcc = _sqrt((Pvis.x - occ.x) * (Pvis.x - occ.x) +
+								(Pvis.y - occ.y) * (Pvis.y - occ.y) +
+								(Pvis.z - occ.z) * (Pvis.z - occ.z));
+							if (dOcc <= 3.f) ++nCasterNear; else ++nCasterFar;
+						}
+						else
+						{
+							++nCasterOff;
+						}
+					}
+					else
+					{
+						++nCasterOff;
+					}
+				}
+
+				Msg("* [DBG] probe d=%u x=%u y=%u z=%.1f pw=(%.2f %.2f %.2f) c=%u u=%.3f v=%.3f dm=%.5f dp=%.5f sh=%d lum=%.3f occ=(%.1f %.1f %.1f) side=%.1f rcv=(%.3f %.3f) cv=(%.3f %.3f) dOcc=%.1f",
+					dumpSeq, x, y, pz, Pw.x, Pw.y, Pw.z, c, u, v, dm, dp, shadowed ? 1 : 0, lum, occ.x, occ.y, occ.z, side, ru, rv, cu, cv, dOcc);
+			}
+		}
+	}
+
+	Msg("* [DBG] probe summary d=%u mode=%d sh1=%u caster_near=%u caster_far=%u caster_off=%u",
+		dumpSeq, onlyCascade, nShadowed, nCasterNear, nCasterFar, nCasterOff);
+}
+
+// Name every static visual near the camera. The numeric probe can say "the shadow map
+// holds a caster at world P that the colour pass does not draw"; only the level's own
+// visual list can then say whether a model exists at P at all, and which .ogf it is.
+static void svp_collect_near_visuals(dxRender_Visual* V, u32 depth, const Fvector& cam, float radius, xr_vector<dxRender_Visual*>& out)
+{
+	if (!V || depth > 10 || out.size() > 4000)
+		return;
+
+	if (V->Type == MT_HIERRARHY)
+	{
+		FHierrarhyVisual* H = (FHierrarhyVisual*)V;
+		for (IRenderVisual* C : H->children)
+			svp_collect_near_visuals((dxRender_Visual*)C, depth + 1, cam, radius, out);
+		return;
+	}
+	if (V->Type == MT_LOD)
+	{
+		FLOD* L = (FLOD*)V;
+		for (IRenderVisual* C : L->children)
+			svp_collect_near_visuals((dxRender_Visual*)C, depth + 1, cam, radius, out);
+		return;
+	}
+	if (V->Type == MT_SKELETON_ANIM || V->Type == MT_SKELETON_RIGID || V->Type == MT_PARTICLE_GROUP)
+		return; // their vis is object-local, not world
+
+	const float d = V->vis.sphere.P.distance_to(cam) - V->vis.sphere.R;
+	if (d < radius)
+		out.push_back(V);
+}
+
+void CRender::CollectNearbyVisuals(float radius, xr_vector<dxRender_Visual*>& out)
+{
+	const Fvector& cam = Device.vCameraPosition;
+	for (IRender_Sector* S : Sectors)
+	{
+		if (!S)
+			continue;
+		CSector* sec = (CSector*)S;
+		if (sec->root())
+			svp_collect_near_visuals(sec->root(), 0, cam, radius, out);
+	}
+	std::sort(out.begin(), out.end(), [&cam](dxRender_Visual* a, dxRender_Visual* b) {
+		return a->vis.sphere.P.distance_to_sqr(cam) < b->vis.sphere.P.distance_to_sqr(cam);
+	});
+}
+
+void CRender::DumpNearbyVisuals(float radius, u32 maxLog)
+{
+	extern float r_ssaDISCARD;
+	extern u32 R_dsgraph_colour_submitted(dxRender_Visual* pVisual);
+	extern u32 R_dsgraph_shadow_submitted(dxRender_Visual* pVisual);
+	const Fvector& cam = Device.vCameraPosition;
+	CFrustum vis_frustum;
+	vis_frustum.CreateFromMatrix(Device.mFullTransform, FRUSTUM_P_ALL);
+	u32 vis_planes = 6;
+	xr_vector<dxRender_Visual*> found;
+	CollectNearbyVisuals(radius, found);
+	Msg("* [DBG] nearvis count=%u (radius %.0f m, listing %u)", u32(found.size()), radius,
+		(u32)std::min<size_t>(found.size(), maxLog));
+	for (u32 i = 0; i < found.size() && i < maxLog; ++i)
+	{
+		dxRender_Visual* V = found[i];
+			// Verdicts of the culling tests that only the COLOUR pass applies. A caster the
+		// probe reports as invisible must be explained by one of these, because the shadow
+		// cascade deliberately skips HOM and the full-detail reject.
+		const float distSQ = V->vis.sphere.P.distance_to_sqr(cam) + EPS;
+		const float ssa = V->vis.sphere.R * V->vis.sphere.R / distSQ;
+		const float nearest = _sqrt(distSQ) - V->vis.sphere.R;
+		const float far_plane = (g_pGamePersistent && g_pGamePersistent->Environment().CurrentEnv)
+			? g_pGamePersistent->Environment().CurrentEnv->far_plane : 600.f;
+		const float fdist = std::max(100.f, far_plane * ps_r4_full_detail_distance_scale);
+		const float transition = clampr((nearest - fdist) / std::max(1.f, far_plane - fdist), 0.f, 1.f);
+		const bool fd_reject = (nearest > fdist) && (ssa <= r_ssaDISCARD * (1.f + transition * 11.f));
+		// The shader element the colour traversal would pick for this visual, and the
+		// vertex/pixel shader of its first pass: "queued but nothing drawn" is only
+		// explainable once the selected element and its passes are visible.
+		ShaderElement* se = rimp_select_sh_static(V, distSQ);
+		LPCSTR vs_name = "-";
+		LPCSTR ps_name = "-";
+		if (se && !se->passes.empty() && se->passes[0])
+		{
+			SPass& p0 = *se->passes[0];
+			if (p0.vs)
+				vs_name = p0.vs->cName.c_str();
+			if (p0.ps)
+				ps_name = p0.ps->cName.c_str();
+		}
+		Msg("* [DBG] nearvis %u v=%p type=%u s=(%.1f %.1f %.1f) r=%.1f d=%.1f box=(%.1f %.1f %.1f)-(%.1f %.1f %.1f) ssa=%.3f(disc %.3f) frust=%d hom=%d fdrej=%d subC=%u subS=%u se=%p npass=%u prio=%u vs=%s ps=%s",
+			i, (void*)V, V->Type,
+			V->vis.sphere.P.x, V->vis.sphere.P.y, V->vis.sphere.P.z, V->vis.sphere.R,
+			V->vis.sphere.P.distance_to(cam),
+			V->vis.box.min.x, V->vis.box.min.y, V->vis.box.min.z,
+			V->vis.box.max.x, V->vis.box.max.y, V->vis.box.max.z,
+			ssa, r_ssaDISCARD, vis_frustum.testSAABB(V->vis.sphere.P, V->vis.sphere.R, V->vis.box.data(), vis_planes) ? 1 : 0,
+			RImplementation.HOM.visible(V->vis.box) ? 1 : 0, fd_reject ? 1 : 0,
+			R_dsgraph_colour_submitted(V), R_dsgraph_shadow_submitted(V),
+			(void*)se, se ? u32(se->passes.size()) : 0u, se ? u32(se->flags.iPriority) : 0u,
+			vs_name, ps_name);
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Measured shadow-to-object alignment (r__sun_shadow_casters companion).
+// For every tall static object near the camera, ask the cascade that is currently
+// resident in rt_smap_depth where it actually put that object's shadow, laterally and
+// along the sun azimuth. A shared transform fault moves every object's shadow by the
+// same amount; a caster-class fault leaves some objects measured and others absent.
+// ---------------------------------------------------------------------------
+struct SvpSceneReadback
+{
+	xr_vector<u8> pos;
+	u32 pw = 0, ph = 0, pp = 0;
+	DXGI_FORMAT pf = DXGI_FORMAT_UNKNOWN;
+	xr_vector<u8> smap;
+	u32 sw = 0, sh = 0, sp = 0;
+	DXGI_FORMAT sf = DXGI_FORMAT_UNKNOWN;
+	float horzTan = 0.f, vertTan = 0.f;
+};
+
+static bool svp_load_scene(SvpSceneReadback& R, CRenderTarget* T, bool need_smap)
+{
+	DXGI_FORMAT f = DXGI_FORMAT_UNKNOWN;
+	if (!svp_read_rt_full(T->rt_Position, R.pos, R.pw, R.ph, R.pp, f))
+		return false;
+	R.pf = f;
+	if (R.pf != DXGI_FORMAT_R16G16B16A16_FLOAT)
+		return false;
+	if (need_smap && !svp_read_rt_full(T->rt_smap_depth, R.smap, R.sw, R.sh, R.sp, f))
+		return false;
+	R.sf = f;
+	if (fabsf(Device.mProject._11) < 1e-6f || fabsf(Device.mProject._22) < 1e-6f)
+		return false;
+	R.horzTan = 1.f / Device.mProject._11;
+	R.vertTan = -1.f / Device.mProject._22;
+	return true;
+}
+
+// Exact inverse of the reconstruction in svp_world_at_pixel, so it cannot disagree with it.
+static bool svp_uv_of_world(const SvpSceneReadback& R, const Fvector& P, float& u, float& v)
+{
+	Fvector Pv;
+	Device.mView.transform_tiny(Pv, P);
+	if (Pv.z < 0.05f)
+		return false;
+	u = 0.5f * (1.f + Pv.x / (Pv.z * R.horzTan));
+	v = 0.5f * (1.f + Pv.y / (Pv.z * R.vertTan));
+	return (u >= 0.f && u <= 1.f && v >= 0.f && v <= 1.f);
+}
+
+static bool svp_world_at_pixel(const SvpSceneReadback& R, u32 x, u32 y, Fvector& out)
+{
+	if (x >= R.pw || y >= R.ph)
+		return false;
+	const u16* hp = (const u16*)(R.pos.data() + size_t(y) * R.pp + size_t(x) * 8);
+	const float pz = svp_h2f(hp[2]);
+	if (pz < 0.2f)
+		return false;
+	const float sx = 2.f * R.horzTan / float(R.pw);
+	const float sy = 2.f * R.vertTan / float(R.ph);
+	Fvector Pv;
+	Pv.set(pz * ((x + 0.5f) * sx - R.horzTan), pz * ((y + 0.5f) * sy - R.vertTan), pz);
+	Device.mInvView.transform(out, Pv);
+	return true;
+}
+
+static bool svp_csm_shadowed(const SvpSceneReadback& R, const Fmatrix& X, const Fvector& Pw)
+{
+	const float cx = Pw.x * X._11 + Pw.y * X._21 + Pw.z * X._31 + X._41;
+	const float cy = Pw.x * X._12 + Pw.y * X._22 + Pw.z * X._32 + X._42;
+	const float cz = Pw.x * X._13 + Pw.y * X._23 + Pw.z * X._33 + X._43;
+	const float cw = Pw.x * X._14 + Pw.y * X._24 + Pw.z * X._34 + X._44;
+	if (cw <= 1e-4f)
+		return false;
+	const float u = 0.5f + 0.5f * cx / cw;
+	const float v = 0.5f - 0.5f * cy / cw;
+	const float dp = cz / cw;
+	if (u < 0.f || u > 1.f || v < 0.f || v > 1.f || dp < 0.f || dp > 1.f)
+		return false;
+	const int ix = clampr(int(u * R.sw), 0, int(R.sw) - 1);
+	const int iy = clampr(int(v * R.sh), 0, int(R.sh) - 1);
+	const u32 raw = *(const u32*)(R.smap.data() + size_t(iy) * R.sp + size_t(ix) * 4);
+	float dm = -1.f;
+	if (R.sf == DXGI_FORMAT_D32_FLOAT || R.sf == DXGI_FORMAT_R32_FLOAT)
+		dm = *(const float*)&raw;
+	else if (R.sf == DXGI_FORMAT_R24G8_TYPELESS || R.sf == DXGI_FORMAT_D24_UNORM_S8_UINT)
+		dm = float(raw & 0x00FFFFFFu) / 16777215.0f;
+	else
+		return false;
+	return dm < dp - 0.001f;
+}
+
+struct SvpShadowSample
+{
+	float s;   // lateral distance from the object axis, metres
+	float t;   // distance down-sun from the object base, metres
+	float y;   // world height of the surface actually drawn there
+	bool shadowed;
+};
+
+// For every tall static object near the camera, ask the cascade that is currently resident
+// in rt_smap_depth where its shadow band actually lies. The samples are taken from the
+// G-buffer surface itself (never from an assumed ground height - that version rejected
+// every sample on a hillside), so terrain relief cannot invalidate the verdict.
+static void svp_measure_shadow_offsets(CRenderTarget* T, const xr_vector<sun::cascade>& cascades,
+	u32 onlyCascade, u32 dumpSeq, const xr_vector<dxRender_Visual*>& objs)
+{
+	if (!T || onlyCascade >= cascades.size() || objs.empty())
+		return;
+	SvpSceneReadback R;
+	if (!svp_load_scene(R, T, true))
+	{
+		Msg("* [DBG] shoffset d=%u c=%u: readback failed", dumpSeq, onlyCascade);
+		return;
+	}
+	CEnvDescriptor& E = *g_pGamePersistent->Environment().CurrentEnv;
+	const Fvector& sd = E.sun_dir;
+	const float hl = _sqrt(sd.x * sd.x + sd.z * sd.z);
+	if (hl < 1e-3f || sd.y > -1e-2f)
+	{
+		Msg("* [DBG] shoffset d=%u c=%u: sun at or below horizon", dumpSeq, onlyCascade);
+		return;
+	}
+	Fvector hdir;
+	hdir.set(sd.x / hl, 0.f, sd.z / hl);   // shadows travel this way on the ground
+	Fvector perp;
+	perp.set(-hdir.z, 0.f, hdir.x);
+	const float tanElev = -sd.y / hl;
+	const Fmatrix& X = cascades[onlyCascade].xform;
+
+	u32 reported = 0;
+	for (dxRender_Visual* V : objs)
+	{
+		const float hgt = V->vis.box.max.y - V->vis.box.min.y;
+		if (hgt < 8.f)
+			continue;
+		Fvector base;
+		base.set((V->vis.box.min.x + V->vis.box.max.x) * .5f, V->vis.box.min.y,
+		         (V->vis.box.min.z + V->vis.box.max.z) * .5f);
+		if (base.distance_to(Device.vCameraPosition) > 45.f)
+			continue;
+
+		const float L = clampr(hgt / tanElev, 4.f, 60.f);
+		const float probe = clampr(L * .5f, 4.f, 20.f);
+		Fvector anchor;
+		anchor.mad(base, hdir, probe);
+		float au, av;
+		if (!svp_uv_of_world(R, anchor, au, av))
+			continue;   // the place where its shadow should be is not on screen
+
+		// Screen window around the anchor, sampled from the drawn surface.
+		xr_vector<SvpShadowSample> samples;
+		const s32 cx = s32(au * R.pw), cy = s32(av * R.ph);
+		for (s32 y = cy - 70; y <= cy + 70; y += 4)
+		{
+			if (y < 0 || y >= s32(R.ph))
+				continue;
+			for (s32 x = cx - 100; x <= cx + 100; x += 4)
+			{
+				if (x < 0 || x >= s32(R.pw))
+					continue;
+				Fvector Pw;
+				if (!svp_world_at_pixel(R, u32(x), u32(y), Pw))
+					continue;
+				const float dx = Pw.x - base.x, dz = Pw.z - base.z;
+				const float s = dx * perp.x + dz * perp.z;
+				const float t = dx * hdir.x + dz * hdir.z;
+				if (fabsf(s) > 14.f || t < 0.f || t > 1.6f * L)
+					continue;
+				SvpShadowSample sm;
+				sm.s = s; sm.t = t; sm.y = Pw.y;
+				sm.shadowed = svp_csm_shadowed(R, X, Pw);
+				samples.push_back(sm);
+			}
+		}
+		if (samples.size() < 40)
+		{
+			Msg("* [DBG] shoffset d=%u c=%u v=%p h=%.1f base=(%.1f %.1f) L=%.1f samples=%u too few",
+				dumpSeq, onlyCascade, (void*)V, hgt, base.x, base.z, L, u32(samples.size()));
+			continue;
+		}
+
+		// Ground level = 10th percentile of the drawn heights in the window; anything well
+		// above it is the object itself or its canopy, not the surface the band falls on.
+		xr_vector<float> heights;
+		heights.reserve(samples.size());
+		for (const SvpShadowSample& sm : samples)
+			heights.push_back(sm.y);
+		std::sort(heights.begin(), heights.end());
+		const float ground_y = heights[heights.size() / 10];
+
+		// Band position at t ~= probe.
+		const float bin = 0.4f;
+		const int nbins = int(28.f / bin);
+		xr_vector<s32> shd(nbins, 0), tot(nbins, 0);
+		int near_ok = 0;
+		for (const SvpShadowSample& sm : samples)
+		{
+			if (fabsf(sm.s) > 14.f || fabsf(sm.t - probe) > 2.5f || sm.y > ground_y + 2.f)
+				continue;
+			const int b = clampr(int((sm.s + 14.f) / bin), 0, nbins - 1);
+			++tot[b];
+			++near_ok;
+			if (sm.shadowed)
+				++shd[b];
+		}
+		float centre = 0.f, width = 0.f;
+		bool found = false;
+		if (near_ok >= 8)
+		{
+			int run_lo = -1, best_lo = -1, best_hi = -1;
+			for (int b = 0; b <= nbins; ++b)
+			{
+				const bool on = (b < nbins) && tot[b] >= 2 && shd[b] * 2 >= tot[b];
+				if (on)
+				{
+					if (run_lo < 0)
+						run_lo = b;
+				}
+				else if (run_lo >= 0)
+				{
+					if (best_lo < 0 || (b - 1 - run_lo) > (best_hi - best_lo))
+					{
+						best_lo = run_lo;
+						best_hi = b - 1;
+					}
+					run_lo = -1;
+				}
+			}
+			if (best_lo >= 0 && best_hi > best_lo)
+			{
+				centre = -14.f + (best_lo + best_hi + 1) * .5f * bin;
+				width = (best_hi - best_lo + 1) * bin;
+				found = true;
+			}
+		}
+
+		// Along-azimuth extent on the band centre line.
+		float first = -1.f, last = -1.f;
+		for (const SvpShadowSample& sm : samples)
+		{
+			if (fabsf(sm.s - (found ? centre : 0.f)) > 2.f || sm.y > ground_y + 2.f)
+				continue;
+			if (!sm.shadowed)
+				continue;
+			if (first < 0.f || sm.t < first)
+				first = sm.t;
+			if (sm.t > last)
+				last = sm.t;
+		}
+
+		Msg("* [DBG] shoffset d=%u c=%u v=%p h=%.1f base=(%.1f %.1f) L=%.1f probe=%.1f samples=%u groundY=%.1f band=%d dlat=%.2f width=%.1f along=%.1f..%.1f",
+			dumpSeq, onlyCascade, (void*)V, hgt, base.x, base.z, L, probe, u32(samples.size()),
+			ground_y, found ? 1 : 0, found ? fabsf(centre) : 0.f, width, first, last);
+		if (++reported >= 12)
+			break;
+	}
+	Msg("* [DBG] shoffset d=%u c=%u reported=%u", dumpSeq, onlyCascade, reported);
+}
+
+// r__sun_shadow_casters 4 puts exactly one object in the map, so everything nearer than
+// the ground in it belongs to that object. Measure that blob in full 24-bit precision and
+// compare it with where cascade.xform says the object's own box projects: the difference
+// is the registration error of the shadow pass, with no neighbour able to confuse it.
+static void svp_single_caster_blob(CRenderTarget* T, const xr_vector<sun::cascade>& cascades,
+                                   u32 onlyCascade, dxRender_Visual* V, u32 dumpSeq)
+{
+	if (!T || !V || onlyCascade >= cascades.size())
+		return;
+	SvpSceneReadback R;
+	if (!svp_load_scene(R, T, true))
+	{
+		Msg("* [DBG] blob d=%u c=%u: readback failed", dumpSeq, onlyCascade);
+		return;
+	}
+	const u32 W = R.sw, H = R.sh;
+	if (!W || !H || R.sf != DXGI_FORMAT_R24G8_TYPELESS)
+	{
+		Msg("* [DBG] blob d=%u c=%u: unsupported smap fmt=%d", dumpSeq, onlyCascade, int(R.sf));
+		return;
+	}
+
+	xr_vector<u32> hist(256, 0);
+	for (u32 y = 0; y < H; ++y)
+	{
+		const u8* row = R.smap.data() + size_t(y) * R.sp;
+		for (u32 x = 0; x < W; ++x)
+		{
+			const u32 raw = *(const u32*)(row + size_t(x) * 4);
+			const u32 dv = (raw & 0x00FFFFFFu) >> 16;   // top 3 bits of the 24-bit depth
+			++hist[dv & 255u];
+		}
+	}
+	// Ground = 90th percentile of stored depth. One caster cannot cover that much of the
+	// map, so the tail of the histogram is the terrain and the far plane.
+	u32 acc = 0;
+	float ground = 1.f;
+	const u32 want = (W * H) / 10 * 9;
+	for (int b = 0; b < 256; ++b)
+	{
+		acc += hist[b];
+		if (acc >= want)
+		{
+			ground = float(b) / 255.f;
+			break;
+		}
+	}
+	const float thr = ground - 0.02f;
+
+	double su = 0.0, sv = 0.0;
+	u32 n = 0;
+	float dmin = 2.f;
+	u32 mx = 0, my = 0;
+	for (u32 y = 0; y < H; ++y)
+	{
+		const u8* row = R.smap.data() + size_t(y) * R.sp;
+		for (u32 x = 0; x < W; ++x)
+		{
+			const u32 raw = *(const u32*)(row + size_t(x) * 4);
+			const float dm = float(raw & 0x00FFFFFFu) / 16777215.0f;
+			if (dm < dmin)
+			{
+				dmin = dm;
+				mx = x;
+				my = y;
+			}
+			if (dm < thr)
+			{
+				su += double(x);
+				sv += double(y);
+				++n;
+			}
+		}
+	}
+
+	const Fmatrix& X = cascades[onlyCascade].xform;
+	float pu = 0.f, pv = 0.f, ptop_u = 0.f, ptop_v = 0.f, ptop_d = 0.f;
+	u32 corners_in = 0;
+	const auto& B = V->vis.box;
+	for (int c = 0; c < 8; ++c)
+	{
+		Fvector p;
+		p.set((c & 1) ? B.max.x : B.min.x, (c & 2) ? B.max.y : B.min.y, (c & 4) ? B.max.z : B.min.z);
+		const float cx = p.x * X._11 + p.y * X._21 + p.z * X._31 + X._41;
+		const float cy = p.x * X._12 + p.y * X._22 + p.z * X._32 + X._42;
+		const float cz = p.x * X._13 + p.y * X._23 + p.z * X._33 + X._43;
+		if (cx < -1.f || cx > 1.f || cy < -1.f || cy > 1.f || cz < 0.f || cz > 1.f)
+			continue;
+		pu += 0.5f + 0.5f * cx;
+		pv += 0.5f - 0.5f * cy;
+		++corners_in;
+		if (c == 7)   // (max.x, max.y, max.z) - the box top, for reference
+		{
+			ptop_u = 0.5f + 0.5f * cx;
+			ptop_v = 0.5f - 0.5f * cy;
+			ptop_d = cz;
+		}
+	}
+	if (corners_in)
+	{
+		pu = pu / float(corners_in) * float(W);
+		pv = pv / float(corners_in) * float(H);
+	}
+	Msg("* [DBG] blob d=%u c=%u v=%p grass=%d ground=%.5f thr=%.5f n=%u centroid=(%.1f %.1f) predict=(%.1f %.1f) dtex=(%.1f %.1f) dmin=%.5f at=(%.1f %.1f) top_pred=(%.1f %.1f d%.5f) corners=%u",
+		dumpSeq, onlyCascade, (void*)V, psDeviceFlags2.test(rsGrassShadow) ? 1 : 0,
+		ground, thr, n,
+		n ? su / double(n) : -1.0, n ? sv / double(n) : -1.0,
+		pu, pv, n ? su / double(n) - double(pu) : 0.0, n ? sv / double(n) - double(pv) : 0.0,
+		dmin, float(mx), float(my),
+		ptop_u * float(W), ptop_v * float(H), ptop_d, corners_in);
+}
+
+// Which source wins for the shadow-relevant shaders. The MO2 profile stacks more than one
+// shader pack and several of these files exist in both, so the file on disk is not evidence
+// of what the engine reads. Reading through the engine FS shows the overlay winner, and the
+// markers tell the two implementations apart (SSFX wind vs the legacy wave, SSFX volumetric
+// sun vs the old raymarch, the +ssfx_issvp.x lens neutralization).
+static void svp_dump_shader_provenance()
+{
+	struct probe { LPCSTR path; };
+	static const probe probes[] = {
+		{ "r3\\shadow_direct_tree.vs" },
+		{ "r3\\deffer_tree_bump.vs" },
+		{ "r3\\deffer_tree_s_bump.vs" },
+		{ "r3\\accum_volumetric_sun.ps" },
+		{ "r3\\accum_sun_far.ps" },
+		{ "r3\\accum_sun_near.ps" },
+		{ "r3\\screenspace_wind.h" },
+		{ "r3\\check_screenspace_SSS.h" },
+	};
+
+	for (const probe& p : probes)
+	{
+		IReader* R = FS.r_open("$game_shaders$", p.path);
+		if (!R)
+		{
+			Msg("* [DBG] shader %s: MISSING", p.path);
+			continue;
+		}
+		xr_string text((LPCSTR)R->pointer(), R->length());
+		Msg("* [DBG] shader %s: %u bytes ssfx_wind=%d legacy_wave=%d hippobot=%d ray_samples=%d issvp_add=%d",
+			p.path, (u32)R->length(),
+			text.find("ssfx_wind_tree") != xr_string::npos,
+			text.find("calc_xz_wave") != xr_string::npos,
+			text.find("Hippobot") != xr_string::npos,
+			text.find("RAY_SAMPLES") != xr_string::npos,
+			text.find("+ ssfx_issvp.x") != xr_string::npos);
+		R->close();
+	}
+}

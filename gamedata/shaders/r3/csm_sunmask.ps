// MT-CN: written in this fork, but only half of it is ours to own: s_vol is SSFX's sun
// volumetric buffer, so this pass is meaningless without SCREEN SPACE SHADERS by
// ascii1457 (https://www.moddb.com/mods/stalker-anomaly/addons/screen-space-shaders).
// Ledger: docs/THIRD_PARTY_PROVENANCE.md.
#include "common.h"

// Engine-side anchor for the SSFX sun volumetric: keep the shafts only around the
// sun's screen position. sun_mask = (sun_uv.x, sun_uv.y, radius, aspect).
Texture2D s_vol;
uniform float4 sun_mask;

float4 main(p_screen I) : SV_Target
{
	float3 vol = s_vol.Sample(smp_linear, I.tc0).rgb;
	float2 d = (I.tc0 - sun_mask.xy) * float2(sun_mask.w, 1.0f);
	float m = 1.0f - smoothstep(sun_mask.z, sun_mask.z * 2.2f, length(d));
	return float4(vol * m, 1.0f);
}
